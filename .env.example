PUBLIC_WA_NUMBER=584240000000
PUBLIC_SITE_URL=https://tudominio.com
PUBLIC_SITE_NAME=Tu Tienda Streaming
PUBLIC_SITE_LOGO=Streaming
PUBLIC_SITE_LOGO_ACCENT=Elite
PUBLIC_COLOR_ACCENT="#f0245f"
PUBLIC_COLOR_ACCENT2="#a78bfa"
PUBLIC_COLOR_BLUE="#60a5fa"
PUBLIC_COLOR_GREEN="#4ade80"

# Multimoneda — si PUBLIC_MULTICURRENCY_ENABLED=false, el sitio queda solo en
# USD y no se muestra ningún selector, sin importar el resto de estas vars.
PUBLIC_MULTICURRENCY_ENABLED=true
# Monedas activas en el selector, además de USD. Códigos soportados: VES, COP.
PUBLIC_CURRENCIES=VES
# Moneda que se muestra por defecto (mientras no haya preferencia guardada).
PUBLIC_DEFAULT_CURRENCY=VES
# Si es "false", el toggle no ofrece volver a USD: los precios quedan fijos
# en las monedas listadas en PUBLIC_CURRENCIES (útil para un sitio mono-moneda).
PUBLIC_ALLOW_USD_TOGGLE=true

PUBLIC_VES_RATES_API_URL=https://www.usdt.com.ve/api/v1/rates/current
PUBLIC_COP_RATES_API_URL=https://co.dolarapi.com/v1/trm
