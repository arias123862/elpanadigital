---
import { SITE_LOGO, SITE_LOGO_ACCENT } from "../data/config";
---
<header class="nav">
  <div class="nav-inner">
    <div class="logo display">{SITE_LOGO}<span class="logo-accent">{SITE_LOGO_ACCENT}</span></div>
    <nav class="nav-links">
      <a href="#catalogo">Catálogo</a>
      <a href="#garantias">Garantías</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href="#catalogo" class="nav-cta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      Ver catálogo
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .logo { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .logo-accent { color: var(--accent); }
  .nav-links { display: flex; gap: 1.75rem; }
  .nav-links a { font-size: 0.92rem; color: var(--text-sub); font-weight: 500; transition: color var(--t); }
  .nav-links a:hover { color: var(--text); }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--green);
    color: #04220f;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    transition: transform var(--t), box-shadow var(--t);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--green) 30%, transparent);
  }
  .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 22px color-mix(in srgb, var(--green) 45%, transparent); }

  @media (max-width: 720px) { .nav-links { display: none; } }
</style>
